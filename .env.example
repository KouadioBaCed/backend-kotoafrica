# Backend environment variables example
# Copy this file to `backend/.env` and set real values for production

# Django secret key
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production

# Debug mode (True/False)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated). Use '*' for all hosts (not recommended in prod)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend base URL consumed by backend (CORS or email links)
FRONTEND_BASE_URL=http://localhost:5173
